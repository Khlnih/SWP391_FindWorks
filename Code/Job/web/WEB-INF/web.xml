<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Job Board</display-name>
    
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <servlet>
        <servlet-name>AdminController</servlet-name>
        <servlet-class>Controller.AdminController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/AdminController</url-pattern>
    </servlet-mapping>
    
    
    <servlet>
        <servlet-name>ajaxServlet</servlet-name>
        <servlet-class>com.vnpay.common.ajaxServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ajaxServlet</servlet-name>
        <url-pattern>/payment</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>VnpayReturn</servlet-name>
        <servlet-class>com.vnpay.common.VnpayReturn</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VnpayReturn</servlet-name>
        <url-pattern>/vnpayReturn</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>JobseekerDetailController</servlet-name>
        <servlet-class>Controller.JobseekerDetailController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>JobseekerDetailController</servlet-name>
        <url-pattern>/JobseekerDetailController</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>RecruiterDetailController</servlet-name>
        <servlet-class>Controller.RecruiterDetailController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>RecruiterDetailController</servlet-name>
        <url-pattern>/RecruiterDetailController</url-pattern>
    </servlet-mapping>
</web-app>
